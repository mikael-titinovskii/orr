# orr requires this API key. The installers require the format `sk-or-v1-`
# followed by exactly 64 lowercase hexadecimal characters. Keyless operation is
# not supported.
OPENROUTER_API_KEY=sk-or-...
ORR_LISTEN=127.0.0.1:8787
ORR_UPSTREAM=https://openrouter.ai/api/v1
# SQLite file holding routing configuration and measurement history. Unset uses
# the platform data directory (%LocalAppData%\orr on Windows, $XDG_DATA_HOME/orr
# elsewhere). A relative value resolves against this file's directory.
# ORR_DB_FILE=orr.db
ORR_LOG_REQUESTS=true
ORR_TUI=true
ORR_PIN_TTL=1h
# Provider-attributed 429s before an automatic pin moves to another provider;
# must be at least 1. The default 1 moves on the first one, so a client without
# its own retries, such as a subagent worker, is not handed a 429. It counts
# automatic pins only: a manual pin never moves and always absorbs the first 429.
# Raise it to 2 or more for the older tolerance, where an automatic pin passes a
# single 429 through first. A 429 that no provider change can answer is absorbed
# with one retry of the same provider after a short bounded wait honouring
# Retry-After up to 3 seconds — a longer hint is not waited out at all, and that
# 429 goes straight to the client — when the pin is manual, or when the threshold
# is reached and no other provider is eligible. A 429 that names no provider at
# all, an account-wide limit, is absorbed the same way whatever this value is.
# The budget is one replay per client request, and the 429 after it: a chain that
# is limited on every provider it moves through delivers its third 429, not its
# second. A rate-limited provider is skipped by automatic selection and automatic
# benchmarks for about two minutes; an unavailable endpoint stays excluded for 30
# minutes.
ORR_429_FAILOVER_THRESHOLD=1
# Degradation recovery for automatic pins: seeds the `d` toggle. The last toggle
# wins over this value once the dashboard has saved one.
ORR_DEGRADATION=true
# Share of a provider's own baseline vitals that still counts as healthy.
ORR_DEGRADATION_THRESHOLD=0.6
# How long the drop must hold before a provider counts as degraded. Must be
# positive and shorter than the 30m baseline it is compared against.
ORR_DEGRADATION_WINDOW=2m
# Answered requests required in the window before vitals are judged at all.
ORR_DEGRADATION_MIN_SAMPLES=3
# Minimum gap between recovery benchmark runs for one model. Must be positive.
ORR_DEGRADATION_COOLDOWN=10m
# How long one recovery refresh and benchmark may take.
ORR_DEGRADATION_TIMEOUT=10s
# What to do when a streamed response starts repeating itself: off, observe,
# abort, or recover. `recover` cuts the repeating tail and asks the model to
# continue from there, which costs one extra upstream request per recovery.
ORR_LOOP_DETECTION=recover
# Shortest repeating stretch, in bytes, that still counts as a loop. Between 8
# and 1024: a shorter unit is rounded up to a multiple of this, and that rounded
# value must still fit the 2048-byte stretch the detector considers — at 2048 a
# 40-byte unit rounds past it, so detection silently never fires instead of
# getting stricter.
ORR_LOOP_MIN_PERIOD=32
# Shortest exactly repeating suffix, in bytes, that confirms a loop. It moves the
# confirmation threshold, not the memory held: the detector keeps a fixed 8 KiB
# ring of recent text per channel, and this value never resizes it. Between 512
# and 8192: below 512 no suffix is ever confirmed anyway, so a smaller value would
# not be the one in force, and above 8192 a minimum never fits in the ring, so
# nothing is ever confirmed and detection silently never fires instead of getting
# stricter. Must also be at least twice ORR_LOOP_MIN_PERIOD, which only bites for
# periods above 256. Raise ORR_LOOP_MIN_PERIOD for longer repeating units.
ORR_LOOP_MIN_REPEAT=512
# Continuations `recover` may request for one response. 0 allows none, so the
# response simply ends at the cut.
ORR_LOOP_MAX_CONTINUATIONS=1
# Repetition penalty sampled on the recovery request. Between 0 and 2; 0 leaves
# sampling untouched.
ORR_LOOP_PENALTY=0.4
ORR_UPDATE_MAX_PROVIDERS=20
ORR_UPDATE_CACHE_ONLY=false
# Optional Kimi Code directory override for integration; set in the shell environment.
# KIMI_CODE_HOME=/path/to/kimi-code

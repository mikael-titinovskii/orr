{
  "openapi": "3.1.0",
  "info": {
    "title": "orr Management API",
    "version": "1.0.3",
    "description": "Manage the running orr proxy with or without its TUI. Local management requests require no authentication header. ORR reads OPENROUTER_API_KEY from environment/dotenv configuration for upstream operations. Anyone who can reach ORR_LISTEN can use the API; keep the default loopback address for local use. Responses are not cached. No prompts, keys, or request/response bodies are exposed. OpenRouter passthrough remains under /v1/*."
  },
  "servers": [
    {
      "url": "/",
      "description": "The running orr listener"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Management"
    }
  ],
  "paths": {
    "/api/v1/stats": {
      "get": {
        "operationId": "getStats",
        "summary": "Read inference statistics",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": "Aggregates use the existing bounded recent-record window. Missing measurements are null; known counts may be zero. Management requests do not count as inference."
      }
    },
    "/api/v1/models": {
      "get": {
        "operationId": "listModels",
        "summary": "List known models and providers",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Models"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/model": {
      "get": {
        "operationId": "getModel",
        "summary": "Read a model?s routing state",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/.+$"
            },
            "example": "author/model",
            "description": "An already known model ID. URL-encode it as a query parameter."
          }
        ]
      }
    },
    "/api/v1/pin": {
      "put": {
        "operationId": "setManualPin",
        "summary": "Set and persist a manual provider pin",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Could not persist the pin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Body exceeds 4 KiB.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Expected application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/.+$"
            },
            "example": "author/model",
            "description": "An already known model ID. URL-encode it as a query parameter."
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Maximum 4 KiB. Unknown fields and trailing JSON are rejected.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Pin"
              },
              "example": {
                "provider": "fireworks"
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "clearManualPin",
        "summary": "Clear the manual override and restore automatic routing",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Model"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Could not persist the pin.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/.+$"
            },
            "example": "author/model",
            "description": "An already known model ID. URL-encode it as a query parameter."
          }
        ]
      }
    },
    "/api/v1/refresh": {
      "post": {
        "operationId": "refreshProviders",
        "summary": "Refresh provider order in the background",
        "tags": [
          "Management"
        ],
        "responses": {
          "202": {
            "description": "Job accepted; poll Location.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative URL of the job resource."
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Another management job is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Server is shutting down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/.+$"
            },
            "example": "author/model",
            "description": "An already known model ID. URL-encode it as a query parameter."
          }
        ],
        "description": "No body. Uses a 30-second upstream timeout. Preserves manual pins in the refreshed order. Upstream, persistence, and revision-conflict failures produce a failed job."
      }
    },
    "/api/v1/benchmarks": {
      "post": {
        "operationId": "benchmarkProviders",
        "summary": "Benchmark providers and apply ranking",
        "tags": [
          "Management"
        ],
        "responses": {
          "202": {
            "description": "Job accepted; poll Location.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            },
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "Relative URL of the job resource."
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "409": {
            "description": "Another management job is running.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Server is shutting down.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "model",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[^/]+/.+$"
            },
            "example": "author/model",
            "description": "An already known model ID. URL-encode it as a query parameter."
          }
        ],
        "description": "No body. Makes billable upstream requests, with a 10-second deadline and at most four concurrent provider tests. Partial results may affect routing. A run fails if incomplete or wholly unsuccessful. Manual pins are preserved and stale results cannot overwrite changed routing."
      }
    },
    "/api/v1/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Poll a background job",
        "tags": [
          "Management"
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Job"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown resource or model.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Allow": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "1"
          }
        ],
        "description": "Jobs are process-local. Retains the last 64 jobs; older completed jobs are evicted. Duplicate running submissions for the same model and kind return the same job. Only one management job runs at a time. Shutdown drains accepted jobs. Restart discards history."
      }
    }
  },
  "components": {
    "schemas": {
      "Model": {
        "type": "object",
        "required": [
          "id",
          "order",
          "providers",
          "active_provider",
          "manual_pin"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "order": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "active_provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "manual_pin": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Models": {
        "type": "object",
        "required": [
          "models"
        ],
        "properties": {
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Model"
            }
          }
        },
        "additionalProperties": false
      },
      "Pin": {
        "type": "object",
        "required": [
          "provider"
        ],
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 1,
            "description": "A tag from this model?s providers list."
          }
        },
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "const": "orr_error"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "Job": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "model",
          "status",
          "created_at",
          "finished_at",
          "error"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "refresh",
              "benchmarks"
            ]
          },
          "model": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "succeeded",
              "failed"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "Stats": {
        "type": "object",
        "required": [
          "request_count",
          "session_request_count",
          "in_flight",
          "daily_costs_usd",
          "daily_tokens",
          "average_ttft_ms",
          "average_tokens_per_second",
          "latency_p50_ms",
          "latency_p95_ms"
        ],
        "properties": {
          "request_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Persisted total inference requests."
          },
          "session_request_count": {
            "type": "integer",
            "minimum": 0
          },
          "in_flight": {
            "type": "integer",
            "minimum": 0
          },
          "daily_costs_usd": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          },
          "daily_tokens": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "average_ttft_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "average_tokens_per_second": {
            "type": [
              "number",
              "null"
            ]
          },
          "latency_p50_ms": {
            "type": [
              "number",
              "null"
            ]
          },
          "latency_p95_ms": {
            "type": [
              "number",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  }
}
